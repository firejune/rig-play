{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // The module itself is bundled by vite (scripts/build-lib.mjs); tsc writes
    // the declarations only.
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    // `@internal` declarations — the adapter's and the loader's helpers, the
    // only ones whose signatures name a rig-c type — are left out of the
    // shipped `.d.ts`, so a consumer's typecheck never looks for `rig-c/core`,
    // which is a devDependency bundled into `index.js` and not installed
    // beside the package.
    "stripInternal": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  // `src/main.ts` lives in `src/` but is not part of the package: it is the
  // demo entry, `index.html` loads it, nothing in the library imports it, and
  // it is absent from the `exports` map. Left in this build it emitted anyway —
  // `dist/main.*` shipped unreachable in 0.4.1 and 0.5.0.
  //
  // `exclude` only filters `include`, never a file that an included file
  // imports, so this drops it from the package and from nothing else:
  // `tsconfig.json` still typechecks it for `bun run build`, vite still reads
  // it, and the day a shipped file imports it it is emitted again and the
  // pinned file list in `tests/package.spec.ts` goes red.
  "exclude": ["src/main.ts"]
}
